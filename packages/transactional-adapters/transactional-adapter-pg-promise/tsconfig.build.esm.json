{
    // ES module build. Emits no declarations, the ones from the CommonJS build
    // are used for both. That is only safe as long as the package has no
    // default export (CJS and ESM default export interop differ), otherwise
    // this build needs its own declarations.
    "extends": "./tsconfig.build.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "outDir": "dist/esm",
        "declaration": false,
        "declarationMap": false
    }
}

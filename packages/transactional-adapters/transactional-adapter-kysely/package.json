{
  "name": "@nestjs-cls/transactional-adapter-kysely",
  "version": "1.5.0",
  "description": "A Kysely adapter for @nestjs-cls/transactional",
  "author": "papooch",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Papooch/nestjs-cls.git"
  },
  "homepage": "https://papooch.github.io/nestjs-cls/",
  "keywords": [
    "nest",
    "nestjs",
    "cls",
    "continuation-local-storage",
    "als",
    "AsyncLocalStorage",
    "async_hooks",
    "request context",
    "async context",
    "transaction",
    "transactional",
    "transactional decorator",
    "aop",
    "kysely"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.mjs",
    "dist/index.mjs.map",
    "dist/index.d.ts",
    "dist/index.d.mts"
  ],
  "scripts": {
    "prepack": "cp ../../../LICENSE ./LICENSE",
    "build": "tsup",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --watch",
    "test:cov": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --coverage"
  },
  "peerDependencies": {
    "@nestjs-cls/transactional": "workspace:^3.3.0",
    "kysely": "^0.28",
    "nestjs-cls": "workspace:^6.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.7",
    "@types/pg": "^8.16.0",
    "jest": "^30.2.0",
    "kysely": "^0.29.5",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}

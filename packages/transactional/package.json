{
  "name": "@nestjs-cls/transactional",
  "version": "3.3.0",
  "description": "A nestjs-cls plugin for transactional decorators",
  "author": "papooch",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Papooch/nestjs-cls.git"
  },
  "homepage": "https://papooch.github.io/nestjs-cls/",
  "keywords": [
    "nest",
    "nestjs",
    "cls",
    "continuation-local-storage",
    "als",
    "AsyncLocalStorage",
    "async_hooks",
    "request context",
    "async context",
    "transaction",
    "transactional",
    "transactional decorator",
    "aop"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE ./LICENSE",
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist/cjs && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist/esm && cp ../../package.cjs.json dist/cjs/package.json && cp ../../package.esm.json dist/esm/package.json",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --watch",
    "test:cov": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --coverage"
  },
  "peerDependencies": {
    "@nestjs/common": ">= 10 < 13",
    "@nestjs/core": ">= 10 < 13",
    "nestjs-cls": "workspace:^6.3.0",
    "reflect-metadata": "*",
    "rxjs": ">= 7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.16.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.7",
    "jest": "^30.2.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}

{
    // CommonJS build, also emits the (single) set of type declarations
    // shared by both builds - see `tsconfig.build.esm.json`.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node10",
        "outDir": "dist/cjs",
        "rootDir": "src",
        "noEmit": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "**/*.spec.ts"]
}

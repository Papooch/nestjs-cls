{
  "name": "nestjs-cls",
  "version": "6.3.1",
  "description": "A continuation-local storage module compatible with NestJS's dependency injection.",
  "author": "papooch",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Papooch/nestjs-cls.git"
  },
  "homepage": "https://papooch.github.io/nestjs-cls/",
  "keywords": [
    "nest",
    "nestjs",
    "cls",
    "continuation-local-storage",
    "als",
    "AsyncLocalStorage",
    "async_hooks",
    "request context",
    "async context"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/cjs/**/*.js",
    "dist/cjs/**/*.d.ts",
    "dist/esm/**/*.js",
    "dist/esm/package.json"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE ./LICENSE && cp ../../README.md ./README.md",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "build:esm": "tsc -p tsconfig.build.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "build:release": "yarn build && yarn build:esm",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --watch",
    "test:cov": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --coverage",
    "test:dual-build": "node test/dual-build/cjs.smoke.cjs && NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest -c jest.dual-build.config.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": ">= 10 < 13",
    "@nestjs/core": ">= 10 < 13",
    "reflect-metadata": "*",
    "rxjs": ">= 7"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.1",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/common": "^12.0.3",
    "@nestjs/common10": "npm:@nestjs/common@10.4.15",
    "@nestjs/core": "^12.0.3",
    "@nestjs/core10": "npm:@nestjs/core@10.4.15",
    "@nestjs/graphql": "^14.0.1",
    "@nestjs/mercurius": "^14.0.1",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/platform-express10": "npm:@nestjs/platform-express@10.4.15",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/platform-fastify10": "npm:@nestjs/platform-fastify@10.4.15",
    "@nestjs/platform-ws": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@nestjs/testing10": "npm:@nestjs/testing@10.4.15",
    "@nestjs/websockets": "^12.0.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "graphql": "^17.0.2",
    "jest": "~30.4.2",
    "mercurius": "^16.10.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "superwstest": "^3.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "ws": "^8.21.3"
  }
}
